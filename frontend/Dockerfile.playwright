FROM mcr.microsoft.com/playwright:v1.58.2-noble

WORKDIR /app

# 优化：加速国内 APT 源
RUN sed -i 's/archive.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list.d/ubuntu.sources \
    && sed -i 's/security.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update && apt-get install -y unzip \
    && rm -rf /var/lib/apt/lists/*

# 1. 优化容器内 Bun 的安装：使用 npmmirror (淘宝镜像源) 极速下载
# 相比 curl，npm install 走国内镜像在构建时更加稳定
RUN npm install -g bun --registry=https://registry.npmmirror.com

# 2. 导出 Bun 路径，确保后续命令可用
ENV PATH="/usr/local/bin:$PATH"

# 3. 准备应用目录
COPY package.json bun.lock /app/

COPY frontend/package.json /app/frontend/

WORKDIR /app/frontend

# 4. 安装依赖：同样强制指定国内 npm 镜像源以加速包下载
RUN bun install --registry=https://registry.npmmirror.com

COPY ./frontend /app/frontend

ARG VITE_API_URL
