# aisec 环境变量示例
#
# 用法：cp .env.example .env，按真实环境填写
#
# 顶层 security-platform/.env 不再注入这些键；aisec 子项目独立维护配置。

# ── GitLab ────────────────────────────────────────────────────────────
GITLAB_URL=https://gitlab.example.com
GITLAB_ACCESS_TOKEN=
GITLAB_WEBHOOK_SECRET=

# ── Anthropic ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7

# ── 独立审计库 ────────────────────────────────────────────────────────
AI_AUDIT_POSTGRES_DSN=postgresql://aisec:aisec@db:5432/aisec_audit

# ── 运行时 ────────────────────────────────────────────────────────────
AI_AUDIT_SOURCE_CACHE_DIR=/var/cache/aisec
AI_AUDIT_AGENT_CONCURRENCY=7
AI_AUDIT_GITLAB_FETCH_CONCURRENCY=10

# ── Neo4j ────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aisecaudit
NEO4J_DATABASE=neo4j

# ── Joern Runner ────────────────────────────────────────────────────
JOERN_RUNNER_URL=http://joern-runner:8090
JOERN_HEAP_SIZE=4g
JOERN_HEARTBEAT_SEC=60

# ── Temporal ────────────────────────────────────────────────────────
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=aisec
WORKFLOW_ID_PREFIX=scan

# ── 流量采集平台对接（HTTP API）─────────────────────────────────────
TRAFFIC_PLATFORM_URL=http://backend:8000
TRAFFIC_PLATFORM_TOKEN=

# ── 定时全量扫描 ────────────────────────────────────────────────────
SCHEDULED_SCAN_CRON=0 2 * * *
SCHEDULED_SCAN_PROJECTS=

# ── 通知 ────────────────────────────────────────────────────────────
NOTIFY_FEISHU_WEBHOOK=
NOTIFY_DINGTALK_WEBHOOK=
NOTIFY_EMAIL_TO=
NOTIFY_MIN_SEVERITY=HIGH

# ── Activity 超时（分钟）───────────────────────────────────────────
AUDIT_TIMEOUT_SOURCE_SYNC_MIN=10
AUDIT_TIMEOUT_BUILD_CPG_MIN=60
AUDIT_TIMEOUT_STORE_NEO4J_MIN=15
AUDIT_TIMEOUT_DISCOVER_MIN=5
AUDIT_TIMEOUT_QUERY_CHAIN_MIN=5
AUDIT_TIMEOUT_AGENTS_MIN=30
AUDIT_TIMEOUT_PERSIST_MIN=5
AUDIT_TIMEOUT_SUMMARIZE_MIN=10
AUDIT_TIMEOUT_PUBLISH_MIN=5

# ── 主库 admin 凭据（init_db 创建 aisec_audit 库时使用）─────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SERVER=db
POSTGRES_PORT=5432
